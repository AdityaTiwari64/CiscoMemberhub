# These VITE_ values are bundled into the browser and are public by design.
# Use only your Supabase project URL and publishable/anon key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Never add a Supabase secret/service_role key or any account password here.
